# Local source package. Place diamond-0.7.9.tar.gz beside this PKGBUILD.
pkgname=diamond
pkgver=0.7.9
pkgrel=1
pkgdesc='Native Markdown notes and source editor built with Rust and egui'
arch=('x86_64')
license=('GPL-3.0-only')
depends=('gcc-libs' 'glibc' 'libx11' 'libxcb' 'libxkbcommon' 'wayland' 'mesa' 'hicolor-icon-theme')
makedepends=('rust' 'cargo' 'pkgconf' 'python' 'librsvg')
optdepends=('xdg-desktop-portal: system file chooser' 'fontconfig: installed font selection' 'noto-fonts-cjk: Chinese glyphs' 'noto-fonts-emoji: color emoji' 'git: plugin installation from GitHub')
source=("$pkgname-$pkgver.tar.gz")
# This local archive is created by its owner, not downloaded from a release.
# Replace SKIP with the result of updpkgsums when distributing the package.
sha256sums=('SKIP')
# Keep makepkg C/C++ LTO flags out of ring's native build; retain Cargo ThinLTO.
options=('!lto')

prepare() {
    cd "$srcdir/$pkgname-$pkgver"
    if [[ ! -f Cargo.lock ]]; then
        cargo generate-lockfile
    fi
    cargo fetch --locked
    # Normalize this source snapshot in makepkg's extracted build directory.
    cargo fmt --all
    if [[ -f "$startdir/diamond.svg" ]]; then
        cp -- "$startdir/diamond.svg" ./diamond.svg
    fi
}

build() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo build --release --frozen --package diamond-app
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    ./scripts/check.sh
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -Dm755 target/release/diamond "$pkgdir/usr/bin/diamond"
    install -Dm644 packaging/diamond.desktop "$pkgdir/usr/share/applications/io.diamond.Diamond.desktop"
    local diamond_icon=assets/diamond.svg
    if [[ -f diamond.svg ]]; then diamond_icon=diamond.svg; fi
    bash packaging/install-icons.sh "$pkgdir" "$diamond_icon"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
    target/release/diamond --syntax-licenses > "$pkgdir/usr/share/licenses/$pkgname/SYNTAXES.md"
    install -Dm644 assets/lucide/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LUCIDE"
    install -Dm644 assets/licenses/LATEX-RUST-MIT.txt "$pkgdir/usr/share/licenses/$pkgname/LATEX-RUST-MIT"
    install -Dm644 assets/licenses/STIX-OFL.txt "$pkgdir/usr/share/licenses/$pkgname/STIX-OFL"
    install -Dm644 assets/licenses/MERMAID-RS-RENDERER-MIT.txt "$pkgdir/usr/share/licenses/$pkgname/MERMAID-RS-RENDERER-MIT"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
