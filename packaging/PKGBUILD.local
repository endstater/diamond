# Build an installable Arch package from the current checkout and its existing target cache.
# Run: cd packaging && makepkg -si -p PKGBUILD.local
pkgname=diamond-notes
pkgver=0.7.11
pkgrel=1
pkgdesc='Native Markdown workspace with process plugins and live editing'
arch=('x86_64' 'aarch64')
url='https://github.com/endstater/diamond'
license=('GPL-3.0-only')
depends=('gcc-libs' 'glibc' 'libx11' 'libxcb' 'libxkbcommon' 'wayland' 'mesa' 'fontconfig' 'hicolor-icon-theme' 'ttf-dejavu')
makedepends=('rust' 'cargo' 'pkgconf' 'librsvg')
optdepends=('git: install plugins from GitHub' 'python: Python plugins' 'xdg-desktop-portal: file and folder chooser' 'noto-fonts-cjk: Chinese text' 'noto-fonts-emoji: native color emoji' 'ttf-montserrat: Montserrat font')
# makepkg's C/C++ LTO flags break ring's native archive at Rust link time.
# Cargo.toml retains the project's Rust ThinLTO setting.
options=('!strip' '!lto')
source=()
sha256sums=()

build() {
    local diamond_checkout
    diamond_checkout="$(realpath "$startdir/..")"
    cd "$diamond_checkout"
    cargo build --release --package diamond-app
}

package() {
    local diamond_checkout
    diamond_checkout="$(realpath "$startdir/..")"
    cd "$diamond_checkout"
    install -Dm755 target/release/diamond "$pkgdir/usr/bin/diamond-notes"
    install -Dm644 packaging/diamond.desktop "$pkgdir/usr/share/applications/io.diamond.Diamond.desktop"
    local diamond_icon=assets/diamond.svg
    if [[ -f diamond.svg ]]; then diamond_icon=diamond.svg; fi
    bash packaging/install-icons.sh "$pkgdir" "$diamond_icon"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
    target/release/diamond --syntax-licenses > "$pkgdir/usr/share/licenses/$pkgname/SYNTAXES.md"
    install -Dm644 THIRD_PARTY_LICENSES.md "$pkgdir/usr/share/doc/$pkgname/THIRD_PARTY_LICENSES.md"
    install -Dm644 assets/lucide/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LUCIDE"
    install -Dm644 assets/licenses/LATEX-RUST-MIT.txt "$pkgdir/usr/share/licenses/$pkgname/LATEX-RUST-MIT"
    install -Dm644 assets/licenses/STIX-OFL.txt "$pkgdir/usr/share/licenses/$pkgname/STIX-OFL"
    install -Dm644 assets/licenses/MERMAID-RS-RENDERER-MIT.txt "$pkgdir/usr/share/licenses/$pkgname/MERMAID-RS-RENDERER-MIT"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
